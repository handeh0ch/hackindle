{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindle-sync.local/contracts/uploads.schema.json",
  "$defs": {
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "device_id": {
          "type": "string",
          "format": "uuid"
        },
        "reset_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "source_snapshot",
            "reading_events",
            "vocabulary_snapshot",
            "legacy_statistics"
          ]
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      },
      "required": [
        "schema_version",
        "instance_id",
        "device_id",
        "reset_generation",
        "source_id",
        "seq",
        "kind",
        "byte_length",
        "sha256",
        "chunk_count"
      ],
      "additionalProperties": false
    },
    "created": {
      "type": "object",
      "properties": {
        "upload_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-5][0-9]([.][0-9]{1,9})?Z$"
        }
      },
      "required": [
        "upload_id",
        "expires_at"
      ],
      "additionalProperties": false
    }
  }
}
