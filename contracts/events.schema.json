{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kindle-sync.local/contracts/events.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "xpointer"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pdf"
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "boxes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "geometry_version": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "page",
            "boxes",
            "geometry_version"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "boxes": {
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "boxes"
                ]
              },
              "then": {
                "properties": {
                  "geometry_version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "geometry_version": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "annotation": {
      "type": "object",
      "properties": {
        "annotation_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "highlight",
            "bookmark"
          ]
        },
        "start": {
          "$ref": "#/$defs/locator"
        },
        "end": {
          "oneOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "native_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "$ref": "#/$defs/context"
        }
      },
      "required": [
        "annotation_id",
        "kind",
        "start",
        "end",
        "quote",
        "note",
        "chapter",
        "native_timestamp",
        "context"
      ],
      "additionalProperties": false
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "type": {
              "const": "reading_segment"
            },
            "native_seconds": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "native_record_id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "measurement_version": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "timing_quality": {
              "enum": [
                "observed_windows",
                "estimated_native_anchor",
                "unavailable"
              ]
            },
            "allocation": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "date",
                  "seconds"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "credited_characters": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "$ref": "#/$defs/locator"
                  },
                  "end": {
                    "$ref": "#/$defs/locator"
                  },
                  "characters": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "start",
                  "end",
                  "characters"
                ],
                "additionalProperties": false
              }
            },
            "awake_windows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "Z$"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "native_anchor": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "volume_quality": {
              "enum": [
                "measured",
                "unavailable"
              ]
            },
            "volume_date": {
              "oneOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "event_id",
            "source_id",
            "session_id",
            "occurred_at",
            "type",
            "native_seconds",
            "native_record_id",
            "measurement_version",
            "provenance",
            "timing_quality",
            "allocation",
            "credited_characters",
            "ranges",
            "awake_windows",
            "native_anchor",
            "volume_quality",
            "volume_date"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "type": {
              "const": "progress_sample"
            },
            "progress": {
              "type": "object",
              "properties": {
                "fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "position": {
                  "$ref": "#/$defs/locator"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                },
                "session_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "fraction",
                "position",
                "observed_at",
                "session_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event_id",
            "source_id",
            "session_id",
            "occurred_at",
            "type",
            "progress"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "type": {
              "const": "session_started"
            },
            "cycle_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "event_id",
            "source_id",
            "session_id",
            "occurred_at",
            "type",
            "cycle_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "type": {
              "const": "session_ended"
            },
            "cycle_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "event_id",
            "source_id",
            "session_id",
            "occurred_at",
            "type",
            "cycle_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "type": {
              "const": "cycle_started"
            },
            "cycle_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "event_id",
            "source_id",
            "session_id",
            "occurred_at",
            "type",
            "cycle_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_id": {
              "type": "string",
              "format": "uuid"
            },
            "occurred_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "type": {
              "const": "book_finished"
            },
            "cycle_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "event_id",
            "source_id",
            "session_id",
            "occurred_at",
            "type",
            "cycle_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "context": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "unavailable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "ready"
            },
            "origin": {
              "enum": [
                "creation",
                "backfill"
              ]
            },
            "captured_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "page_basis": {
              "enum": [
                "rendered",
                "original_pdf"
              ]
            },
            "total_pages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "before": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "number",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "selection_pages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "number",
                  "text"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "after": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "number",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "origin",
            "captured_at",
            "page_basis",
            "total_pages",
            "before",
            "selection_pages",
            "after"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
