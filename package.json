{
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "name": "kindle-sync",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "type": "module",
  "scripts": {
    "test:contracts": "node --test --experimental-test-coverage --test-coverage-include=contracts/**/*.js --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/contracts/*.test.js",
    "start": "node index.js",
    "dev": "node index.js",
    "migrate": "node scripts/migrate.js",
    "setup:owner": "node scripts/setup-owner.js",
    "backup:export": "node scripts/export-backup.js",
    "backup:import": "node scripts/import-backup.js",
    "test:server": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=server/**/*.js --test-coverage-include=scripts/*.js --test-coverage-include=index.js --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/server/*.test.js"
  }
}
