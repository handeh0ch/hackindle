# Configuration contract; application implementation is pending plan review.
# Copy to .env locally or set values in your deployment's secret/environment store.
# Supply your own PostgreSQL connection strings. Never commit populated secrets.
DATABASE_URL=
DIRECT_DATABASE_URL=

# Public origin of YOUR instance; this is a reserved example, not a live endpoint.
APP_ORIGIN=https://example.invalid

# Instance reporting policy. Set before first initialization.
REPORT_TIMEZONE=UTC
PAGE_CHARACTERS=2000

# Standalone Node.js listener; the Vercel adapter does not open this port.
HOST=0.0.0.0
PORT=3000

# Number of trusted reverse-proxy hops. Configure for your deployment topology.
TRUST_PROXY=0
